FrameWidgetClass BC_TraderMenu {
 position 0 0
 size 1 1
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass Window {
   color 0.08 0.07 0.06 0.92
   position 0 0
   size 960 600
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style rover_sim_colorable
   {
    TextWidgetClass Title {
     position 20 12
     size 600 36
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text "Obchod"
     font "gui/fonts/metron28"
     "text halign" left
     "text valign" center
    }
    TextWidgetClass Balance {
     position 620 12
     size 320 36
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text "Penize: 0"
     font "gui/fonts/metron28"
     "text halign" right
     "text valign" center
    }
