   position 0 0
   size 520 400
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style rover_sim_colorable
   {
    TextWidgetClass Title {
     position 20 12
     size 480 36
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text "Bankomat"
     font "gui/fonts/metron28"
     "text halign" center
     "text valign" center
    }
