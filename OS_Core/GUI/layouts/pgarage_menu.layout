FrameWidgetClass OS_PersonalGarageMenu {
 position 0 0
 size 1 1
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass Window {
   color 0.08 0.07 0.06 0.92
   position 0 0
   size 560 330
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style rover_sim_colorable
   {
    TextWidgetClass Title {
     position 20 12
     size 520 36
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text "Osobni garaz"
     font "gui/fonts/metron28"
     "text halign" center
     "text valign" center
    }
    TextWidgetClass Info {
     position 20 58
     size 520 26
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text ""
     font "gui/fonts/metron"
     "text halign" center
     "text valign" center
    }
    TextWidgetClass Info2 {
     position 20 86
     size 520 26
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text ""
     font "gui/fonts/metron"
     "text halign" center
     "text valign" center
    }
    ButtonWidgetClass BtnBuild {
     color 0.25 0.22 0.18 1
     position 20 124
     size 520 40
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Default
     text "Postavit garaz zde"
     font "gui/fonts/metron"
    }
    ButtonWidgetClass BtnSetSpawn {
     color 0.25 0.22 0.18 1
     position 20 124
     size 520 40
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Default
     text "Nastavit misto pro vozidlo"
     font "gui/fonts/metron"
    }
    ButtonWidgetClass BtnRemove {
     color 0.25 0.22 0.18 1
     position 20 172
     size 520 40
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Default
     text "Zrusit garaz"
     font "gui/fonts/metron"
    }
    ButtonWidgetClass BtnClose {
     color 0.25 0.22 0.18 1
     position 20 240
     size 520 40
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Default
     text "Zavrit"
     font "gui/fonts/metron"
    }
    TextWidgetClass Status {
     position 20 290
     size 520 26
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text ""
     font "gui/fonts/metron"
     "text halign" center
     "text valign" center
    }
   }
  }
 }
}
