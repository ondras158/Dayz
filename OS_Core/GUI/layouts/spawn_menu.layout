FrameWidgetClass OS_SpawnMenu {
 position 0 0
 size 1 1
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass Window {
   color 0.08 0.07 0.06 0.92
   position 0 0
   size 520 500
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style rover_sim_colorable
   {
    TextWidgetClass Title {
     position 20 12
     size 480 36
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text "Vyber misto spawnu"
     font "gui/fonts/metron28"
     "text halign" center
     "text valign" center
    }
    TextWidgetClass Countdown {
     position 20 50
     size 480 26
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text ""
     font "gui/fonts/metron"
     "text halign" center
     "text valign" center
    }
    PanelWidgetClass ZoneListBg {
     color 0 0 0 0.6
     position 20 85
     size 480 300
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     style rover_sim_colorable
    }
    TextListboxWidgetClass ZoneList {
     position 24 89
     size 472 292
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     font "gui/fonts/metron"
    }
    ButtonWidgetClass BtnSpawn {
     color 0.25 0.22 0.18 1
     position 20 400
     size 230 50
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Default
     text "Spawnout zde"
     font "gui/fonts/metron"
    }
    ButtonWidgetClass BtnStay {
     color 0.25 0.22 0.18 1
     position 270 400
     size 230 50
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Default
     text "Zustat tady"
     font "gui/fonts/metron"
    }
    TextWidgetClass Status {
     position 20 460
     size 480 26
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text ""
     font "gui/fonts/metron"
     "text halign" center
     "text valign" center
    }
   }
  }
 }
}
