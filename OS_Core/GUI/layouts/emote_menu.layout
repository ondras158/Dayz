FrameWidgetClass OS_EmoteMenu {
 position 0 0
 size 1 1
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass Window {
   color 0.08 0.07 0.06 0.92
   position 0 0
   size 460 600
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style rover_sim_colorable
   {
    TextWidgetClass Title {
     position 20 12
     size 420 36
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text "Emoce a spanek"
     font "gui/fonts/metron28"
     "text halign" center
     "text valign" center
    }
    PanelWidgetClass EmoteListBg {
     color 0 0 0 0.6
     position 20 56
     size 420 410
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     style rover_sim_colorable
    }
    TextListboxWidgetClass EmoteList {
     position 24 60
     size 412 402
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     font "gui/fonts/metron"
    }
    ButtonWidgetClass BtnPlay {
     color 0.25 0.22 0.18 1
     position 20 476
     size 205 40
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Default
     text "Prehrat"
     font "gui/fonts/metron"
    }
    ButtonWidgetClass BtnClose {
     color 0.25 0.22 0.18 1
     position 235 476
     size 205 40
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Default
     text "Zavrit"
     font "gui/fonts/metron"
    }
    TextWidgetClass Hint {
     position 20 522
     size 420 24
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text "Dvojklik = prehrat. Pohyb emoci ukonci."
     font "gui/fonts/metron"
     "text halign" center
     "text valign" center
    }
    TextWidgetClass Status {
     position 20 552
     size 420 26
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text ""
     font "gui/fonts/metron"
     "text halign" center
     "text valign" center
    }
   }
  }
 }
}
