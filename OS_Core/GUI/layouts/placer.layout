FrameWidgetClass OS_Placer {
 ignorepointer 1
 position 0 0
 size 1 1
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 {
  CanvasWidgetClass Canvas {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
  }
  PanelWidgetClass HintBg {
   ignorepointer 1
   color 0 0 0 0.6
   position 0 40
   size 1100 40
   halign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style rover_sim_colorable
  }
  TextWidgetClass Hint {
   ignorepointer 1
   color 0.6 1 0.65 1
   position 0 40
   size 1100 40
   halign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text ""
   font "gui/fonts/metron"
   "text halign" center
   "text valign" center
  }
 }
}
