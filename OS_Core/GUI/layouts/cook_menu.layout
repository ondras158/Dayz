     position 20 12
     size 820 36
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text "Vareni podle receptu"
     font "gui/fonts/metron28"
     "text halign" center
     "text valign" center
    }
