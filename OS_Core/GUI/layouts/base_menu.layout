FrameWidgetClass OS_BaseMenu {
 position 0 0
 size 1 1
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass Window {
   color 0.08 0.07 0.06 0.92
   position 0 0
   size 560 400
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style rover_sim_colorable
   {
    TextWidgetClass Title {
     position 20 12
     size 520 36
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text "Base"
     font "gui/fonts/metron28"
     "text halign" center
     "text valign" center
    }
    TextWidgetClass Info1 {
     position 20 56
     size 520 26
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text ""
     font "gui/fonts/metron"
     "text halign" center
     "text valign" center
    }
    TextWidgetClass Info2 {
     position 20 84
     size 520 26
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text ""
     font "gui/fonts/metron"
     "text halign" center
     "text valign" center
    }
    TextWidgetClass Info3 {
     position 20 112
     size 520 26
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text ""
     font "gui/fonts/metron"
     "text halign" center
     "text valign" center
    }
    ButtonWidgetClass BtnFound {
     color 0.25 0.22 0.18 1
     position 20 156
     size 520 40
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Default
     text "Zalozit base"
     font "gui/fonts/metron"
    }
    ButtonWidgetClass BtnUpgrade {
     color 0.25 0.22 0.18 1
     position 20 156
     size 520 40
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Default
     text "Zvetsit polomer"
     font "gui/fonts/metron"
    }
    ButtonWidgetClass BtnRemove {
     color 0.25 0.22 0.18 1
     position 20 206
     size 520 40
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Default
     text "Zrusit base"
     font "gui/fonts/metron"
    }
    TextWidgetClass Hint {
     position 20 256
     size 520 26
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text "Kodovy zamek na branu: majitel a skupina odemknou bez kodu"
     font "gui/fonts/metron"
     "text halign" center
     "text valign" center
    }
    ButtonWidgetClass BtnClose {
     color 0.25 0.22 0.18 1
     position 20 300
     size 520 40
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Default
     text "Zavrit"
     font "gui/fonts/metron"
    }
    TextWidgetClass Status {
     position 20 350
     size 520 26
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     ignorepointer 1
     text ""
     font "gui/fonts/metron"
     "text halign" center
     "text valign" center
    }
   }
  }
 }
}
